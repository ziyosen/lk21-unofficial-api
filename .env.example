NODE_ENV = production
LK21_BASE_MOVIE = https://tv12.lk21official.cc/
LK21_BASE_SERIES = https://tv9.nontondrama.my
PORT = 8000

# ==== PROXY (anti Cloudflare-block) ====
# Semua request lewat scrapper/fetcher.js: coba proxy terbukti -> direct -> rotasi daftar.
# Pilih salah satu:
# PROXY_LIST = http://host1:port,http://host2:port   (dipisah koma)
# PROXY_FILE = /path/ke/proxies.txt                  (satu proxy per baris)
# PROXY_LIST=
# PROXY_FILE=
# Timeout per request dalam ms (opsional, default 25000)
# FETCH_TIMEOUT_MS = 25000
